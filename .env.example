# =============================================================================
# The Divine Tarot — one site, one Supabase project.
# Copy to .env.local for development; add the same keys in Vercel → Settings →
# Environment Variables for production. Never commit real values.
# =============================================================================

# ---- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://thedivinetarotonline.com
NEXT_PUBLIC_APP_URL=https://thedivinetarotonline.com
NEXT_PUBLIC_SITE_HOST=thedivinetarotonline.com

# ---- Supabase (database + the single login for the whole site) ---------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Secrets (generate each with: openssl rand -hex 32) ----------------------
READING_TOKEN_SECRET=      # signs 20-minute card "pick" tokens in the reading chat
NEWSLETTER_SECRET=         # signs one-click unsubscribe links
FORM_SECRET=               # signs the personal-reading form cookie
CRON_SECRET=               # Vercel Cron sends it as "Authorization: Bearer …"
BOOKING_ADMIN_TOKEN=       # password for /personal-reading/admin (or give a user app_metadata.role = "admin")

# ---- Razorpay ---------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Webhook secrets (Razorpay → Settings → Webhooks), one per webhook URL:
RAZORPAY_READING_WEBHOOK_SECRET=   # /api/razorpay/reading-webhook  (payment.captured, order.paid)
BOOKING_RAZORPAY_WEBHOOK_SECRET=   # /api/booking/razorpay-webhook  (payment_link.paid)
KUNDLI_RAZORPAY_WEBHOOK_SECRET=    # /api/kundli-report/webhook     (payment.captured)
# Optional: a separate Razorpay account for personal readings
BOOKING_RAZORPAY_KEY_ID=
BOOKING_RAZORPAY_KEY_SECRET=

# ---- Email ------------------------------------------------------------------
# Resend (password reset, newsletter, support, kundli reports). Domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=The Divine Tarot <hello@thedivinetarotonline.com>
RESEND_FROM_EMAIL=The Divine Tarot <hello@thedivinetarotonline.com>
# Gmail SMTP (personal-reading confirmations with calendar invite + photos)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Divine Tarot" <dev.thedivinetarot111@gmail.com>
OWNER_EMAIL=dev.thedivinetarot111@gmail.com      # booking + support notifications (comma list allowed)
SUPPORT_EMAIL=dev.thedivinetarot111@gmail.com

# ---- Personal reading: Google Calendar / Meet (OAuth refresh token) -----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
CALENDAR_GUESTS=
CALL_MINUTES=40
# Optional price overrides (₹). The Diwali offer price lives in src/lib/booking/offer.ts.
PRICE_INR=8500
PRICE_URGENT_INR=17000

# ---- Reading chat: optional AI fallback (Anthropic > OpenAI > Gemini) ---------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Newsletter / WhatsApp / YouTube -----------------------------------------
YOUTUBE_CHANNEL_ID=UC93V0T62ER8cvjio8rAIqCQ
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# ---- Kundli report log (optional Google Sheet Apps Script) --------------------
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_TOKEN=

# ---- Rate limiting (optional; login/booking/support also have DB limits) ------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Monitoring & analytics (optional) ---------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ---- Account cleanup cron ------------------------------------------------------
# Accounts that never buy a pass are deleted 24–48 h after signup (client rule).
CLEANUP_PROTECTED_EMAILS=dev.sitelytc@gmail.com,demo@ginnikibaatein.com
APP_STORE_URL=
